# スカウター拡張機能 - 環境変数（ビルド時に読み込み）
# 本番ビルド時: .env を作成し、以下をコピーして実際のURLに書き換える
# 例: cp .env.example .env && 編集

# バックエンド API のベースURL
# ローカル開発: http://localhost:8765
# 本番: 未定の場合はプレースホルダー。後で Render/Railway/Cloudflare のURLに書き換える
VITE_API_ENDPOINT=https://api.yourdomain.com

# 録音アプリ（Next.js ワークスペース）のベースURL
# ローカル: http://127.0.0.1:3002
# 本番: https://your-app.vercel.app
VITE_APP_BASE_URL=https://app.yourdomain.com
