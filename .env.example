TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Cloudflare R2（音声ファイル保存用）
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# M1 Hybrid Scouter（mlx-whisper ローカル文字起こし）
USE_MLX_WHISPER=false
MLX_WHISPER_URL=http://localhost:8765

# 音声アップロード用バックエンド（Vercel 4.5MB 制限回避のため直接送信）
# ローカル: http://127.0.0.1:8765（localhost より安定）
# 本番: Render 等のバックエンド URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
